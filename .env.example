# KnowledgeOS - variables de entorno (ver src/knowledgeos/config.py para los defaults
# reales que usa la app si una variable falta). Copia este archivo a `.env`:
#   cp .env.example .env
# Los valores por defecto ya funcionan contra el compose.yaml de este repo tal cual;
# solo API_TOKEN se DEBE cambiar antes de exponer el servicio fuera de tu maquina.

# --------------------------------------------------------------------- base de datos

# Cadena de conexion usada tanto por la API como por compose.yaml (servicio postgres).
# Formato: postgresql://<user>:<password>@<host>:<port>/<database>
# En modo dev local (API fuera de Docker) el host es "localhost"; si la API corre
# DENTRO de docker compose (`docker compose --profile full up -d`), compose.yaml ya
# sobreescribe esta variable a host "postgres" (el nombre del servicio) por ti - no
# hace falta duplicar el .env para eso.
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos

# Password del servicio postgres de compose.yaml. Debe coincidir con el password de
# DATABASE_URL de arriba. Genera uno con: openssl rand -hex 32
POSTGRES_PASSWORD=knowledgeos

# --------------------------------------------------------------------- autenticacion

# Token "root": Bearer estatico con todos los scopes (read/write/admin) sobre todos
# los contextos, comparado con secrets.compare_digest (plan_v2.md SS9). Pensado para
# ti mismo / el primer bootstrap - para agentes individuales usa tokens con scope
# (`knowledgeos token create <name> --scopes read,write [--contexts a,b]`), que
# quedan en la tabla `api_tokens` (solo su hash SHA-256, nunca el valor en claro) y
# se pueden revocar sin tocar este valor. CAMBIALO antes de exponer la API fuera de
# tu propia maquina.
API_TOKEN=change-me-dev-token

APP_HOST=0.0.0.0
APP_PORT=8000

# --------------------------------------------------------------------- embeddings

# fastembed model id. Debe coincidir con EMBEDDING_DIMENSION de abajo - si cambias el
# modelo despues de tener datos, hace falta re-embeder toda la tabla `memories`
# (dimension distinta de la columna pgvector existente).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Dimension del vector del modelo de arriba. Usada para dimensionar la columna
# `memories.embedding` (pgvector) en la primera migracion.
EMBEDDING_DIMENSION=384

# --------------------------------------------------------------------- Context Engine (Fase 2)
# Umbrales del scoring determinista de scope=auto (plan_v2.md SS7). Calibrados a mano
# contra evals/ - ver README "Context Engine" antes de tocarlos. Comentados aqui
# porque los defaults (src/knowledgeos/config.py) ya son los calibrados; descomenta
# solo si vas a experimentar con otros valores.

# Tamano del retrieval preliminar sin filtro de contexto (top-N candidato).
# CONTEXT_ENGINE_CANDIDATE_POOL=20

# Un contexto "domina" (-> auto-scope) si su score normalizado (0..1) es >= esto...
# CONTEXT_ENGINE_DOMINANCE_THRESHOLD=0.45
# ...Y ademas su margen sobre el 2do contexto (normalizado) es >= esto.
# CONTEXT_ENGINE_MARGIN_THRESHOLD=0.25

# Boost aditivo por cada unidad de peso de context_preferences que matchea un token
# de la query (deliberadamente pequeno - ver comentario en config.py).
# CONTEXT_ENGINE_PREFERENCE_BOOST_PER_WEIGHT=0.008

# Boost aditivo flat cuando la query menciona explicitamente el slug o el name de un
# contexto (p.ej. "en Expense Tracker...").
# CONTEXT_ENGINE_MENTION_BOOST=0.12

# Cuantos candidatos (2-4) devolver cuando el caso es ambiguo.
# CONTEXT_ENGINE_CANDIDATES_MIN=2
# CONTEXT_ENGINE_CANDIDATES_MAX=4

# Cuantos resultados por candidato devolver junto con la lista de ambiguedad.
# CONTEXT_ENGINE_RESULTS_PER_CANDIDATE=3

# --------------------------------------------------------------------- Fase 4: clasificador local opcional
# OFF por defecto ("none" -> NullResolver, cero cambio de comportamiento). Solo tiene
# sentido activarlo en serio cuando (a) haya >= ~500 desambiguaciones registradas
# (`knowledgeos export-disambiguations`) y (b) haya una razon medida (latencia, costo,
# o una politica de privacidad estricta) - ver README "Clasificador local opcional".
# CONTEXT_ENGINE_RESOLVER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b
