# Connection string used both by the API and by docker compose's postgres service.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos

# Static bearer token required on every authenticated endpoint (Authorization: Bearer <token>).
API_TOKEN=change-me-dev-token

# fastembed model id. Must match EMBEDDING_DIMENSION below.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector dimension of the embedding model above. Used to size the `memories.embedding`
# pgvector column on first migration. Changing the model later requires re-embedding
# the whole table if the dimension changes.
EMBEDDING_DIMENSION=384

APP_HOST=0.0.0.0
APP_PORT=8000

# --- Fase 4: clasificador local opcional (OFF por defecto, ver README) -----------
# CONTEXT_ENGINE_RESOLVER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b
