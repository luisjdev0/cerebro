# KnowledgeOS - environment variables (see src/knowledgeos/config.py for the
# real defaults the app uses if a variable is missing). Copy this file to `.env`:
#   cp .env.example .env
# The default values already work against this repo's compose.yaml as-is;
# only API_TOKEN MUST be changed before exposing the service outside your machine.

# --------------------------------------------------------------------- database

# Connection string used both by the API and by compose.yaml (postgres service).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# In local dev mode (API outside Docker) the host is "localhost"; if the API runs
# INSIDE docker compose (`docker compose --profile full up -d`), compose.yaml
# already overrides this variable to host "postgres" (the service name) for you -
# no need to duplicate .env for that.
DATABASE_URL=postgresql://knowledgeos:knowledgeos@localhost:5432/knowledgeos

# Password for compose.yaml's postgres service. Must match the password in
# DATABASE_URL above. Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=knowledgeos

# HOST ports that compose.yaml publishes (127.0.0.1 only) for postgres and the
# two APIs (`full` profile). The container's internal port never changes (always
# 5432/8000) - this only controls the left-hand side of the mapping, for servers
# where those ports are already taken by something else (e.g. a shared server
# that already runs its own Postgres on 5432 for other apps). If you change
# POSTGRES_HOST_PORT and run the API OUTSIDE docker compose (local dev,
# `python -m cerebro_memory.main`), also update the port in DATABASE_URL above
# so they match.
POSTGRES_HOST_PORT=5432
CEREBRO_MEMORY_HOST_PORT=8005
CEREBRO_DOCS_HOST_PORT=8006
CEREBRO_FLOWS_HOST_PORT=8007
CEREBRO_AUTH_HOST_PORT=8008
REDIS_HOST_PORT=6379

# Internal gateway (Caddy, `gateway` service in compose.yaml, `full` profile):
# routes /memory, /docs, /flows, /auth by prefix to each API and exposes a single
# port, so an EXTERNAL Caddy (your VPS's) points at this port once instead of one
# block per service -- see "Exposing it behind a single reverse_proxy" in the
# README and gateway/Caddyfile.
CEREBRO_GATEWAY_HOST_PORT=8080

# --------------------------------------------------------------------- authentication

# "Root" token: static Bearer with all scopes (read/write/admin) over all
# contexts, compared with secrets.compare_digest (plan_v2.md SS9). Meant for
# yourself / the first bootstrap - for individual agents use scoped tokens
# (`knowledgeos token create <name> --scopes read,write [--contexts a,b]`), which
# are stored in the `api_tokens` table (only their SHA-256 hash, never the plain
# value) and can be revoked without touching this value. CHANGE IT before
# exposing the API outside your own machine.
API_TOKEN=change-me-dev-token

APP_HOST=0.0.0.0
APP_PORT=8000

# --------------------------------------------------------------------- embeddings

# fastembed model id. Must match EMBEDDING_DIMENSION below - if you change the
# model after having data, the whole `memories` table needs to be re-embedded
# (different dimension than the existing pgvector column).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector dimension of the model above. Used to size the `memories.embedding`
# column (pgvector) in the first migration.
EMBEDDING_DIMENSION=384

# --------------------------------------------------------------------- Context Engine (Phase 2)
# Thresholds for the deterministic scope=auto scoring (plan_v2.md SS7). Hand
# calibrated against evals/ - see the README's "Context Engine" before touching
# them. Commented out here because the defaults (src/knowledgeos/config.py) are
# already the calibrated ones; uncomment only if you're going to experiment with
# other values.

# Size of the preliminary retrieval without context filtering (top-N candidate).
# CONTEXT_ENGINE_CANDIDATE_POOL=20

# A context "dominates" (-> auto-scope) if its normalized score (0..1) is >= this...
# CONTEXT_ENGINE_DOMINANCE_THRESHOLD=0.45
# ...AND its margin over the 2nd context (normalized) is also >= this.
# CONTEXT_ENGINE_MARGIN_THRESHOLD=0.25

# Additive boost per unit of context_preferences weight that matches a query
# token (deliberately small - see the comment in config.py).
# CONTEXT_ENGINE_PREFERENCE_BOOST_PER_WEIGHT=0.008

# Flat additive boost when the query explicitly mentions a context's slug or
# name (e.g. "in Expense Tracker...").
# CONTEXT_ENGINE_MENTION_BOOST=0.12

# How many candidates (2-4) to return when the case is ambiguous.
# CONTEXT_ENGINE_CANDIDATES_MIN=2
# CONTEXT_ENGINE_CANDIDATES_MAX=4

# How many results per candidate to return alongside the ambiguity list.
# CONTEXT_ENGINE_RESULTS_PER_CANDIDATE=3

# --------------------------------------------------------------------- Phase 4: optional local classifier
# OFF by default ("none" -> NullResolver, zero behavior change). Only worth
# turning on for real once (a) there are >= ~500 recorded disambiguations
# (`knowledgeos export-disambiguations`) and (b) there's a measured reason
# (latency, cost, or a strict privacy policy) - see the README's "Optional local
# classifier".
# CONTEXT_ENGINE_RESOLVER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:1.5b

# --------------------------------------------------------------------- cerebro-docs
# cerebro-docs is a SIBLING service to cerebro-memory: same Postgres instance
# (DATABASE_URL/POSTGRES_PASSWORD above), but its own `cerebro_docs` schema
# (see packages/cerebro-docs/db/migrations/001_init.sql) and its own process, with
# the SAME variables as above (DATABASE_URL, API_TOKEN, APP_HOST, APP_PORT - see
# packages/cerebro-docs/src/cerebro_docs/config.py). When running it locally
# outside Docker, give it its own .env (or its own cwd) so it doesn't stomp on
# cerebro-memory's values - specifically:
#   APP_PORT=8010                          (cerebro-memory uses 8000/8005)
#   API_TOKEN=change-me-dev-token-docs     (root token independent from memory's)
# cerebro-docs has no embeddings/Context Engine variables: it doesn't do semantic
# retrieval, only simple full-text (ecosistema-cerebro.md SS2/SS7).

# --------------------------------------------------------------------- cerebro-flows
# cerebro-flows is another SIBLING service (luisjdev-pendientes/cerebro-flows): same
# shared Postgres (its own `cerebro_flows` schema) PLUS Redis (new service in
# compose.yaml, only the mutable pointer of a run -- the flow definition itself
# lives in Postgres). Same base variables as memory/docs (DATABASE_URL, API_TOKEN,
# APP_HOST, APP_PORT - see packages/cerebro-flows/src/cerebro_flows/config.py). Outside
# of Docker, give it its own .env/cwd, with its own port:
#   APP_PORT=8020                          (memory uses 8000/8005, docs 8010/8006)
#   API_TOKEN=change-me-dev-token-flows    (independent root token)

# Redis URL. In local dev mode (outside Docker) the host is "localhost"; inside
# docker compose (`--profile full`), compose.yaml already overrides it to the
# "redis" service name for you.
REDIS_URL=redis://localhost:6379/0

# Sliding TTL (hours) for a run's pointer in Redis -- renewed on every
# flow_next/checkpoint, not fixed from the start. A run abandoned without an
# explicit `flow_abort` expires from Redis on its own after this much inactivity
# (the history in Postgres, flow_run_events, survives regardless).
FLOW_RUN_TTL_HOURS=72

# --------------------------------------------------------------------- cerebro-auth
# cerebro-auth owns the shared `cerebro_auth` schema (users, groups, api_tokens)
# that memory/docs/flows now validate every request against directly (same
# Postgres, cross-schema query, no network hop) -- see
# packages/cerebro-auth/src/cerebro_auth/config.py. Same base variables as the
# others (DATABASE_URL, API_TOKEN, APP_HOST, APP_PORT). Outside of Docker, give
# it its own .env/cwd, with its own port:
#   APP_PORT=8030                          (memory/docs/flows use 8000/8005-8007)
#   API_TOKEN=change-me-dev-token-auth     (independent root token)
